# Base de datos (docker-compose expone PostgreSQL en el puerto 5433)
DATABASE_URL="postgresql://homemed:homemed@127.0.0.1:5433/homemed?schema=public&connect_timeout=20"

# Auth.js — genera uno con: npx auth secret  (o openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"
# Necesario detrás de proxy / en producción
AUTH_TRUST_HOST=true

# Estilos de mapa (CARTO, sin API key). Se pueden cambiar a MapTiler / Stadia.
NEXT_PUBLIC_MAP_STYLE_LIGHT="https://basemaps.cartocdn.com/gl/positron-gl-style/style.json"
NEXT_PUBLIC_MAP_STYLE_DARK="https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json"

# Almacenamiento de fotos: "local" guarda en /public/uploads; "db" en PostgreSQL (tabla StoredFile).
# Si se deja vacío: "db" en Vercel (su disco no es persistente) y "local" en el resto.
STORAGE_DRIVER="local"

# Correo («Mot de passe oublié») con Resend (https://resend.com). Sin clave, en desarrollo el enlace
# se escribe en la consola del servidor; en producción es obligatoria.
RESEND_API_KEY=""
# Remitente; el dominio debe estar verificado en Resend, p. ej. "ALLO TABIB <no-reply@allotabib.mr>"
EMAIL_FROM=""
# URL pública para los enlaces de los correos (en Vercel, si falta, se usa el dominio de producción)
APP_URL="http://localhost:3000"

# Seed: "false" en producción → solo zonas y especialidades (sin admin de prueba ni profesionales ficticios).
SEED_DEMO="true"
# Credenciales del admin de prueba que crea el seed (solo con SEED_DEMO distinto de "false")
SEED_ADMIN_PHONE="+22200000000"
SEED_ADMIN_PASSWORD="admin1234"

# Estilos adicionales del selector de mapa (opcionales; por defecto CARTO Voyager y Esri World Imagery)
NEXT_PUBLIC_MAP_STYLE_VOYAGER="https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json"
NEXT_PUBLIC_MAP_SATELLITE_TILES="https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"

# Panel oculto para bloquear/desbloquear la web (si falta alguna, el panel no existe).
# Ruta secreta, larga y difícil de adivinar (mín. 8 caracteres), p. ej. /ctl-7f3k9q2x
SITE_CONTROL_PATH=""
# Genera el hash con: npm run site-control -- hash
SITE_CONTROL_PASSWORD_HASH=""
